  "version": 2,
  "buildCommand": "npm install",
  "framework": "express",
  "functions": {
    "api/index.js": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "env": {
    "BACKEND_URL": "@backend_url",
    "NODE_ENV": "production"
  },
  "regions": ["sfo1"],
  "public": true
}
