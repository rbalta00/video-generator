# ============================================
# VIDEO GENERATOR - ENVIRONMENT VARIABLES
# ============================================

# NODE ENVIRONMENT
NODE_ENV=production
PORT=3000

# BACKEND CONFIGURATION
# URL del backend Python (Railway, Render, etc)
# Ej: https://video-generator-backend.railway.app
BACKEND_URL=http://localhost:5000

# OPCIONAL: Si quieres usar Python localmente
PYTHON_BACKEND_ENABLED=false

# ============================================
# VARIABLES LEGACY (Si usas Python localmente)
# ============================================

# CLOUDINARY - Para subir imágenes/videos
CLOUDINARY_CLOUD=dswrrm5u1
CLOUDINARY_KEY=tu_cloudinary_api_key_aqui
CLOUDINARY_SECRET=tu_cloudinary_api_secret_aqui

# SHOPIFY - Para crear páginas
SHOPIFY_STORE=tu-tienda.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# WHATSAPP - Número default
DEFAULT_WHATSAPP=5251234567890
